      "source": [
        "\n",
        "# Implementation of Expectation-Maximization (EM) Algorithm\n",
        "# Using Gaussian Mixture Model with Graphs\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.mixture import GaussianMixture\n",
        "\n",
        "# Step 1: Create sample data\n",
        "np.random.seed(42)\n",
        "\n",
        "data1 = np.random.normal(3, 0.7, 100)\n",
        "data2 = np.random.normal(7, 0.8, 100)\n",
        "\n",
        "X = np.concatenate([data1, data2]).reshape(-1, 1)\n",
        "\n",
        "# Step 2: Create the EM model\n",
        "model = GaussianMixture(\n",
        "    n_components=2,\n",
        "    random_state=42,\n",
        "    n_init=5\n",
        ")\n",
        "\n",
        "# Step 3: Train the model using EM\n",
        "model.fit(X)\n",
        "\n",
        "# Step 4: Predict cluster labels\n",
        "labels = model.predict(X)\n",
        "\n",
        "# Step 5: Display results\n",
        "print(\"Expectation-Maximization Algorithm\")\n",
        "print(\"----------------------------------\")\n",
        "print(\"Number of clusters:\", model.n_components)\n",
        "print(\"Cluster means:\", model.means_.flatten())\n",
        "print(\"Converged:\", model.converged_)\n",
        "print(\"Number of iterations:\", model.n_iter_)\n",
        "\n",
        "# Step 6: Plot clustered data\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.scatter(\n",
        "    X[:, 0],\n",
        "    np.zeros(len(X)),\n",
        "    c=labels,\n",
        "    cmap=\"viridis\",\n",
        "    s=35\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Data Values\")\n",
        "plt.yticks([])\n",
        "plt.title(\"EM Algorithm - Data Clustering\")\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# Step 7: Plot Gaussian distributions\n",
        "x_axis = np.linspace(X.min() - 1, X.max() + 1, 500)\n",
        "x_axis_2d = x_axis.reshape(-1, 1)\n",
        "\n",
        "density = np.exp(model.score_samples(x_axis_2d))\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.hist(\n",
        "    X[:, 0],\n",
        "    bins=25,\n",
        "    density=True,\n",
        "    alpha=0.4,\n",
        "    label=\"Data Histogram\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    x_axis,\n",
        "    density,\n",
        "    linewidth=2,\n",
        "    label=\"Combined Gaussian Density\"\n",
        ")\n",
        "\n",
        "# Plot individual Gaussian components\n",
        "for i in range(model.n_components):\n",
        "    mean = model.means_[i, 0]\n",
        "    variance = model.covariances_[i].flatten()[0]\n",
        "    weight = model.weights_[i]\n",
        "\n",
        "    component = (\n",
        "        weight / np.sqrt(2 * np.pi * variance)\n",
        "        * np.exp(-0.5 * (x_axis - mean) ** 2 / variance)\n",
        "    )\n",
        "\n",
        "    plt.plot(\n",
        "        x_axis,\n",
        "        component,\n",
        "        linestyle=\"--\",\n",
        "        label=\"Gaussian Component \" + str(i + 1)\n",
        "    )\n",
        "\n",
        "plt.xlabel(\"Data Values\")\n",
        "plt.ylabel(\"Probability Density\")\n",
        "plt.title(\"EM Algorithm - Gaussian Mixture Model\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n"
      ]
    }
  ]
